{
  "name": "@tsdotnet/websocket-connector",
  "version": "1.0.6",
  "description": "Universal WebSocket connector base class with connection pooling, virtual connections, and testing utilities",
  "author": "electricessence",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "module-sync": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "module": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./node": {
      "module-sync": {
        "types": "./dist/types/node.d.ts",
        "default": "./dist/esm/node.js"
      },
      "module": {
        "types": "./dist/types/node.d.ts",
        "default": "./dist/esm/node.js"
      },
      "import": {
        "types": "./dist/types/node.d.ts",
        "default": "./dist/esm/node.js"
      },
      "require": {
        "types": "./dist/cjs/node.d.ts",
        "default": "./dist/cjs/node.js"
      },
      "default": {
        "types": "./dist/types/node.d.ts",
        "default": "./dist/esm/node.js"
      }
    },
    "./browser": {
      "module-sync": {
        "types": "./dist/types/browser.d.ts",
        "default": "./dist/esm/browser.js"
      },
      "module": {
        "types": "./dist/types/browser.d.ts",
        "default": "./dist/esm/browser.js"
      },
      "import": {
        "types": "./dist/types/browser.d.ts",
        "default": "./dist/esm/browser.js"
      },
      "require": {
        "types": "./dist/cjs/browser.d.ts",
        "default": "./dist/cjs/browser.js"
      },
      "default": {
        "types": "./dist/types/browser.d.ts",
        "default": "./dist/esm/browser.js"
      }
    },
    "./mock": {
      "module-sync": {
        "types": "./dist/types/mock.d.ts",
        "default": "./dist/esm/mock.js"
      },
      "module": {
        "types": "./dist/types/mock.d.ts",
        "default": "./dist/esm/mock.js"
      },
      "import": {
        "types": "./dist/types/mock.d.ts",
        "default": "./dist/esm/mock.js"
      },
      "require": {
        "types": "./dist/cjs/mock.d.ts",
        "default": "./dist/cjs/mock.js"
      },
      "default": {
        "types": "./dist/types/mock.d.ts",
        "default": "./dist/esm/mock.js"
      }
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "keywords": [
    "websocket",
    "connector",
    "rxjs",
    "observable",
    "disposable",
    "virtual-connections",
    "connection-pooling",
    "testing",
    "mock",
    "test-utilities"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "copy:dts": "cpy \"src/**/*.d.ts\" dist/types --parents || echo No .d.ts files to copy",
    "copy:dts:cjs": "cpy \"src/**/*.d.ts\" dist/cjs --parents || echo No .d.ts files to copy",
    "build:types": "pnpm copy:dts && node ./node_modules/typescript-native/bin/tsc -p tsconfig.types.json",
    "build:esm": "rollup -c rollup.config.js",
    "build:cjs": "node ./node_modules/typescript-native/bin/tsc -p tsconfig.cjs.json && pnpm copy:dts:cjs && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\"",
    "build": "pnpm clean && pnpm build:types && pnpm build:esm && pnpm build:cjs && pnpm typecheck:tests",
    "test": "vitest run",
    "typecheck": "node ./node_modules/typescript-native/bin/tsc --noEmit",
    "typecheck:tests": "node ./node_modules/typescript-native/bin/tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docs": "rimraf docs && npx typedoc --options typedoc.json --readme none",
    "bump": "pnpm run precommit && pnpm version patch",
    "precommit": "pnpm build && pnpm test && pnpm lint && git status -s",
    "preversion": "pnpm lint && pnpm test",
    "postversion": "git push && git push --tags && pnpm run docs && git add -A && git commit -m \"Updated docs.\" docs && git push",
    "prepublishOnly": "pnpm build && pnpm test && pnpm lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsdotnet/websocket-connector.git"
  },
  "bugs": {
    "url": "https://github.com/tsdotnet/websocket-connector/issues"
  },
  "homepage": "https://github.com/tsdotnet/websocket-connector#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.1.1",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.15.0",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.7",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@tsdotnet/disposable": "^2.0.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "ws": "^8.23.0"
  },
  "pnpm": {
    "overrides": {
      "hosted-git-info@<2.8.9": ">=2.8.9",
      "y18n@=4.0.0": ">=4.0.1",
      "lodash@<4.17.20": ">=4.17.20",
      "shell-quote@<=1.7.2": ">=1.7.3",
      "lodash@<4.17.21": ">=4.17.21",
      "json5@<1.0.2": ">=1.0.2",
      "json5@>=2.0.0 <2.2.2": ">=2.2.2",
      "minimatch@<3.0.5": ">=3.0.5",
      "semver@<5.7.2": ">=5.7.2",
      "semver@>=6.0.0 <6.3.1": ">=6.3.1",
      "semver@>=7.0.0 <7.5.2": ">=7.5.2",
      "get-func-name@<2.0.1": ">=2.0.1",
      "@babel/traverse@<7.23.2": ">=7.23.2",
      "braces@<3.0.3": ">=3.0.3",
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1",
      "vite@>=7.0.0 <=7.3.1": ">=7.3.2",
      "vite@>=7.1.0 <=7.3.1": ">=7.3.2",
      "esbuild@>=0.17.0 <0.28.1": ">=0.28.1",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "vite@>=7.0.0 <=7.3.4": ">=7.3.5",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "vite@>=7.0.0 <=7.3.6": ">=7.3.7",
      "typedoc>minimatch": "^10.2.5"
    },
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-g3hv-75wg-m249"
      ]
    }
  }
}
